# Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME="Smart Energy Intelligence"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY=change-this-to-a-very-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./data/smart_energy.db

# Home Assistant Integration (stored server-side only, never exposed to browser)
# HA_BASE_URL=http://homeassistant.local:8123
# HA_TOKEN=your_long_lived_access_token_here
# HA_VERIFY_SSL=false

# Telemetry Collection
TELEMETRY_INTERVAL_SECONDS=30
TELEMETRY_RETRY_LIMIT=3

# Demo Mode
DEMO_MODE=true
DEMO_DATA_SEED=42

# Tariff
DEFAULT_CURRENCY=INR
DEFAULT_TARIFF_RATE=8.00

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Timezone
TIMEZONE=Asia/Kolkata
